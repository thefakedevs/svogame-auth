DEBUG_PORT=5173
# Frontend dev server runs on DEBUG_PORT and proxies /api to backend.
BINDING_ADDRESS=127.0.0.1:3001
DATABASE_URL=sqlite://db.sqlite?mode=rwc
BACKEND_PORT=3001
VITE_API_TARGET=http://127.0.0.1:3001

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=svogame
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_FORCE_PATH_STYLE=true

DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_EVENTS_GUILD_ID=your_discord_events_guild_id
DISCORD_HTTP_TIMEOUT_MS=5000
# Optional override for integration testing; production default is Discord API v10.
DISCORD_API_BASE_URL=https://discord.com/api/v10

# Metrics ingestion is disabled (503) when this secret is absent or empty.
METRICS_INGEST_SECRET=replace_with_a_long_random_secret
METRICS_UPLOAD_MAX_BYTES=16777216
METRICS_UPLOAD_TIMEOUT_SECONDS=60
# Optional: completed matches stay pending in the outbox until a channel and bot token are configured.
METRICS_DISCORD_CHANNEL_ID=your_metrics_channel_id
METRICS_DISCORD_RETRY_INTERVAL_SECONDS=60
METRICS_DISCORD_MAX_ATTEMPTS=10
METRICS_PUBLIC_BASE_URL=https://svocraft.xyz

EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=xyecoc
XYECOC_MAIL_LOGIN=your_xyecoc_login
XYECOC_MAIL_PASSWORD=your_xyecoc_password
XYECOC_API_BASE_URL=https://api.xyecoc.com
XYECOC_MAIL_CURRENT_LANG=mail
XYECOC_AUTH_LOCAL_PART_ONLY=true
XYECOC_HTTP_TIMEOUT_MS=10000
EMAIL_RETRY_INTERVAL_SECONDS=300
EMAIL_FAILURE_AFTER_SECONDS=86400

JWT_SECRET=your_jwt_secret_change_me
POW_COMPLEXITY=15
SHOP_PAYMENT_PROVIDER=mock
SHOP_PENDING_PAYMENT_TTL_SECONDS=900
SHOP_RECONCILIATION_INTERVAL_SECONDS=30
YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_SECRET_KEY=your_yookassa_secret_key
# Optional. If omitted, backend falls back to http://127.0.0.1:${DEBUG_PORT}/api/docs
YOOKASSA_RETURN_URL=http://127.0.0.1:5173/api/docs
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3

SHOP_RECEIPTS_ENABLED=false
SHOP_RECEIPTS_PROVIDER=mytax
MYTAX_INN=your_mytax_inn
MYTAX_PASSWORD=your_mytax_password
MYTAX_API_BASE_URL=https://lknpd.nalog.ru/api/v1
MYTAX_DEVICE_PREFIX=svogame_
MYTAX_ZONE_OFFSET=+03:00
MYTAX_RECEIPT_RETRY_INTERVAL_SECONDS=900
MYTAX_RECEIPT_FAILURE_AFTER_SECONDS=604800
