---
import BaseLayout from './BaseLayout.astro'
import './PublicLayout.css'
import { paths } from '../routes/paths'

interface Props {
  title?: string
  description?: string
}

const { title = 'SVO Game', description } = Astro.props
---

<BaseLayout title={title} description={description}>
  <div class="ui-kit-vhs" aria-hidden="true"></div>
  <div class="ui-kit-page public-layout">
    <header class="public-layout__header">
      <a href={paths.home} class="public-layout__brand">SVO Game</a>
      <nav class="public-layout__nav" aria-label="Основная навигация">
        <a href={paths.home}>Главная</a>
        <a href={paths.cabinet}>Кабинет</a>
        <a href={paths.auth} class="public-layout__nav-accent">Войти</a>
      </nav>
    </header>
    <main class="public-layout__main">
      <slot />
    </main>
  </div>
</BaseLayout>
